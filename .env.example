# Supabase Postgres — MUST be the session pooler host.
# vm26's notes record that db.<ref>.supabase.co does not resolve.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Optional — only for `npm run preview`, which runs the real Cloudflare Worker locally.
# In production the /api endpoints reach Postgres through the Hyperdrive binding; locally there is
# no Hyperdrive, so wrangler wants the connection string it should stand in with. Same value as
# DATABASE_URL above.
#   CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$DATABASE_URL
#
# NOT an environment variable either: CLOUDFLARE_DEPLOY_HOOK is a *repository* secret. Every sync
# job POSTs it so Cloudflare rebuilds the site with the data the job just wrote — the site is a
# static export, so the numbers change on a deploy rather than on a write. Create it under
# Workers > fpl > Settings > Builds > Deploy Hooks. The URL is the credential; it needs no header.

# Optional — where raw FPL payloads are cached. Defaults to ./tmp/raw
# FPL_CACHE_DIR=
#
# Optional — soccerdata scrape cache. Defaults to ~/soccerdata
# SOCCERDATA_DIR=

# Optional — the mini-league to compute effective ownership against. Defaults to 422500
# ("Hakuna Mateta") in sync/jobs/league.py. Not a secret: a league id is in the URL of every
# standings page. Override only to point at a different league.
# https://fantasy.premierleague.com/leagues/XXXXXX/standings/c
# FPL_LEAGUE_ID=422500

# Optional — the FPL entry whose squad `/me` shows. Defaults to 1617827 in sync/jobs/manager.py.
# Also public.
# FPL_ENTRY_ID=1617827

# NOT an environment variable. The GitHub PAT that lets pg_cron trigger the hourly snapshot
# (migration 0019) lives in Supabase Vault, because the thing that needs it is a Postgres
# function — no Python code ever reads it. Fine-grained token, Actions:read-and-write on this
# repo only. To rotate:
#
#   select vault.update_secret(id, '<new token>', 'github_actions_pat', description)
#   from vault.secrets where name = 'github_actions_pat';
#   select dispatch_workflow('sync-snapshot.yml');   -- then collect_dispatch_results() → 204
#
# There is no expiry warning anywhere. `workflow_dispatch_health.last_error` showing 401 is how
# you find out, and `python -m sync.cli verify` fails on it.
